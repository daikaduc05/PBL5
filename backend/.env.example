# ── Database ───────────────────────────────────────────────────────────────────
# SQLite mặc định (ephemeral trên Railway - mất data khi redeploy)
DATABASE_URL=sqlite:///./posetrack.db

# Dùng PostgreSQL Railway (persistent) - uncomment và điền URL từ Railway dashboard:
# DATABASE_URL=postgresql://user:password@host:5432/railway

# ── CORS ───────────────────────────────────────────────────────────────────────
# Để "*" cho dev/demo, hoặc điền URL của PWA khi deploy production:
# CORS_ORIGINS=https://posetrack-pwa.vercel.app,https://posetrack-pwa.railway.app
CORS_ORIGINS=*

# ── Server ─────────────────────────────────────────────────────────────────────
# PORT được inject tự động bởi Railway, không cần set ở đây
# PORT=8002
